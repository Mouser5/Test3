@startuml agent_interface

skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam shadowing false

title Интерфейс агента для игры "Гномы-вредители: Дуэль"

package "Интерфейс агента" {
    interface AgentInterface {
        + player_id: int
        + choose_action(game: Game): Optional[AgentAction]
    }
}

package "Встроенные агенты" {
    class RandomAgent {
        - player_id: int
        + choose_action(game: Game): Optional[AgentAction]
    }
    
    class HeuristicAgent {
        - player_id: int
        - logger: Logger
        + choose_action(game: Game): Optional[AgentAction]
        - _select_best_action(game: Game, actions: List[AgentAction]): AgentAction
        - _choose_best_build_action(game: Game, actions: List[ActionBuild]): Optional[ActionBuild]
        - _distance_to_nearest_unrevealed_gold(x: int, y: int, game: Game): Optional[int]
        - _choose_best_map_action(game: Game, actions: List[ActionPlayBoardUtility]): Optional[ActionPlayBoardUtility]
        - _pick_best_sabotage(actions: List[ActionPlayPlayerUtility], opponent_state: PlayerState): ActionPlayPlayerUtility
        - _choose_best_rockfall(game: Game, actions: List[ActionPlayBoardUtility], opponent_id: int): Optional[ActionPlayBoardUtility]
        - _choose_best_discard(game: Game, actions: List[ActionDiscard]): Optional[ActionDiscard]
    }
    
    class SmartAgent {
        - player_id: int
        - lookahead_depth: int
        + choose_action(game: Game): Optional[AgentAction]
        - _evaluate_position(game: Game): float
    }
}

package "Пользовательский агент" {
    class UserAgent <<Ваш класс>> {
        - player_id: int
        + choose_action(game: GameProxy): Optional[AgentAction]
    }
}

package "Прокси доступа" {
    class GameProxy {
        + player_id: int
        + get_legal_actions(): List[AgentAction]
        + get_hand(): List[str]
        + get_board(): Dict
        + get_broken_equipments(player_id: int): List[str]
        + get_scores(): Dict[int, int]
        + is_game_over(): bool
    }

    class Game {
        + player_id: int
        + step(action): Tuple
        + get_legal_actions(): List[AgentAction]
        + get_observation(player_id): ObservableMatchState
        + is_round_over(): bool
        + is_game_over(): bool
    }
}

AgentInterface <|.. RandomAgent : реализует
AgentInterface <|.. HeuristicAgent : реализует
AgentInterface <|.. SmartAgent : реализует
AgentInterface <|.. UserAgent : реализует

SmartAgent --|> HeuristicAgent : наследует

UserAgent --> GameProxy : получает (контейнер)
RandomAgent --> Game : получает (локально)
HeuristicAgent --> Game : получает (локально)

note right of UserAgent
  **Требования:**
  1. Конструктор принимает player_id: int
  2. Метод choose_action(game: GameProxy) -> AgentAction
  3. Используйте game.get_legal_actions(), game.get_hand(), game.get_board()
  4. Свои поломанные предметы: game.get_broken_equipments(game.player_id)
  5. Поломанные предметы оппонента: game.get_broken_equipments(1 - game.player_id)
  6. Возвращайте None если нет ходов
end note

note bottom of AgentInterface
  **AgentAction** — это одно из:
  - ActionBuild
  - ActionPlayBoardUtility
  - ActionPlayPlayerUtility
  - ActionDiscard
end note

note bottom of GameProxy
  **Ограниченный обзор:**
  - Своя рука (get_hand)
  - Доска с туман войны (get_board)
  - Поломанные предметы обоих (get_broken_equipments)
  - Счёт (get_scores)
  - Легальные действия (get_legal_actions)
  - Рука оппонента скрыта
end note

@enduml
