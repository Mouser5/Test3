@startuml Game State Machine (1 Round)
hide empty description

title Диаграмма состояний игры "Гномы-вредители: Дуэль" (1 раунд)

skinparam state {
    BackgroundColor<<ready>> #E8F5E9
    BackgroundColor<<busy>> #FFF3E0
    BackgroundColor<<error>> #FFEBEE
    BackgroundColor<<terminal>> #E1BEE7
}

[*] --> Инициализация

state "Инициализация" as Инициализация {
    state "Готов" as InitReady <<ready>>
    state "Занят" as InitBusy <<busy>>
    state "Ошибка" as InitError <<error>>

    [*] --> InitReady
    InitReady --> InitBusy : начало настройки
    InitBusy --> InitReady : настройка завершена
    InitBusy --> InitError : ошибка инициализации
    InitError --> InitReady : повторная попытка
}

Инициализация --> ХодИгрока0 : начало раунда

state "Ход игрока 0" as ХодИгрока0 {
    state "Ожидание" as Player0Ready <<ready>>
    state "Обработка действия" as Player0Choosing <<busy>>
    state "Валидация хода" as Player0Validating <<busy>>
    state "Выполнение хода" as Player0Executing <<busy>>
    state "Ошибка хода" as Player0Error <<error>>

    [*] --> Player0Ready
    Player0Ready --> Player0Choosing : запрос действия
    Player0Choosing --> Player0Validating : действие получено
    Player0Validating --> Player0Executing : ход корректен
    Player0Validating --> Player0Error : ход некорректен
    Player0Error --> Player0Ready : возврат к выбору
    Player0Executing --> Player0Ready : ход применён
}

ХодИгрока0 --> ХодИгрока1 : ход завершён

state "Ход игрока 1" as ХодИгрока1 {
    state "Ожидание" as Player1Ready <<ready>>
    state "Обработка действия" as Player1Choosing <<busy>>
    state "Валидация хода" as Player1Validating <<busy>>
    state "Выполнение хода" as Player1Executing <<busy>>
    state "Ошибка хода" as Player1Error <<error>>

    [*] --> Player1Ready
    Player1Ready --> Player1Choosing : запрос действия
    Player1Choosing --> Player1Validating : действие получено
    Player1Validating --> Player1Executing : ход корректен
    Player1Validating --> Player1Error : ход некорректен
    Player1Error --> Player1Ready : возврат к выбору
    Player1Executing --> Player1Ready : ход применён
}

ХодИгрока1 --> ПроверкаРаунда : ход завершён

state "Проверка раунда" as ПроверкаРаунда {
    state "Ожидание" as CheckReady <<ready>>
    state "Анализ условий" as CheckBusy <<busy>>
    state "Раунд завершён" as RoundEnd <<ready>>
    state "Раунд активен" as RoundContinue <<ready>>

    [*] --> CheckReady
    CheckReady --> CheckBusy : проверка условий
    CheckBusy --> RoundEnd : золото раскрыто / карты закончились
    CheckBusy --> RoundContinue : есть доступные ходы
    RoundContinue --> [*] : передача хода
    RoundEnd --> [*] : переход к подсчёту
}

ПроверкаРаунда --> ХодИгрока0 : продолжение раунда (игрок 0)
ПроверкаРаунда --> ХодИгрока1 : продолжение раунда (игрок 1)
ПроверкаРаунда --> ПодсчётРаунда : завершение раунда

state "Подсчёт очков" as ПодсчётРаунда {
    state "Ожидание" as ScoreReady <<ready>>
    state "Вычисление" as ScoreBusy <<busy>>
    state "Сохранение" as ScoreSave <<busy>>

    [*] --> ScoreReady
    ScoreReady --> ScoreBusy : начало подсчёта
    ScoreBusy --> ScoreSave : очки вычислены
    ScoreSave --> [*] : результаты сохранены
}

ПодсчётРаунда --> ПроверкаИгры : передача управления

state "Проверка конца игры" as ПроверкаИгры {
    state "Ожидание" as GameCheckReady <<ready>>
    state "Анализ раундов" as GameCheckBusy <<busy>>
    state "Игра активна" as GameContinue <<ready>>
    state "Игра завершена" as GameEnd <<ready>>

    [*] --> GameCheckReady
    GameCheckReady --> GameCheckBusy : проверка счётчика раундов
    GameCheckBusy --> GameContinue : раунд < 3
    GameCheckBusy --> GameEnd : раунд = 3
    GameContinue --> [*] : начало нового раунда
    GameEnd --> [*] : переход к определению победителя
}

ПроверкаИгры --> ОпределениеПобедителя : игра окончена

state "Определение победителя" as ОпределениеПобедителя <<terminal>> {
    state "Ожидание" as WinnerReady <<ready>>
    state "Сравнение очков" as WinnerBusy <<busy>>
    state "Победитель 0" as Win0 <<ready>>
    state "Победитель 1" as Win1 <<ready>>
    state "Ничья" as Draw <<ready>>

    [*] --> WinnerReady
    WinnerReady --> WinnerBusy : получены финальные очки
    WinnerBusy --> Win0 : score[0] > score[1]
    WinnerBusy --> Win1 : score[1] > score[0]
    WinnerBusy --> Draw : score[0] = score[1]
    Win0 --> [*]
    Win1 --> [*]
    Draw --> [*]
}

ОпределениеПобедителя --> [*] : игра завершена

legend right
    |= Цвет |= Значение |
    | <#E8F5E9> Зелёный | Состояние "Ожидание/Готовность" |
    | <#FFF3E0> Оранжевый | Состояние "Обработка/Активность" |
    | <#FFEBEE> Красный | Состояние "Ошибка" |
    | <#E1BEE7> Фиолетовый | Терминальное состояние |
endlegend

@enduml